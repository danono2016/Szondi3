{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szondi3.local/schema/open_question.schema.json",
  "title": "Szondi3 P2A Cross-Source Open Question",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "questionId",
    "topic",
    "implicatedDoctrineIds",
    "issue",
    "evidenceNeeded",
    "currentEvidence",
    "status",
    "notes"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "questionId": {"type": "string", "pattern": "^UQ_[0-9]{6}$"},
    "topic": {"type": "string", "minLength": 1},
    "implicatedDoctrineIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DR_[A-Z0-9_]+_[0-9]{6}$"}
    },
    "issue": {"type": "string", "minLength": 1},
    "evidenceNeeded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "currentEvidence": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["OPEN", "WAITING_SOURCE", "WAITING_REVIEW", "RESOLVED", "RETIRED"]},
    "notes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  }
}
