{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szondi3.local/schema/transversal_concept.schema.json",
  "title": "Szondi3 P2A Transversal Concept Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "conceptId",
    "preferredLabel",
    "retrievalLabels",
    "germanTerms",
    "romanianLabels",
    "aliases",
    "linkedDoctrineIds",
    "sourceIds",
    "broaderConceptIds",
    "narrowerConceptIds",
    "chronologyNotes",
    "terminologyNotes",
    "unresolvedNotes",
    "reviewStatus"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "conceptId": {"type": "string", "pattern": "^DC_[0-9]{6}$"},
    "preferredLabel": {"type": "string", "minLength": 1},
    "retrievalLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "germanTerms": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "romanianLabels": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "aliases": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "linkedDoctrineIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DR_[A-Z0-9_]+_[0-9]{6}$"}
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "broaderConceptIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DC_[0-9]{6}$"}
    },
    "narrowerConceptIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^DC_[0-9]{6}$"}
    },
    "chronologyNotes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "terminologyNotes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "unresolvedNotes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "reviewStatus": {
      "enum": ["PROPOSED", "SOURCE_RECHECKED", "CLINICIAN_REVIEWED", "ACCEPTED", "UNRESOLVED", "REOPENED"]
    }
  }
}
